---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { CATEGORIES } from "../data/site";
import { visiblePosts } from "../utils/posts";

const posts = visiblePosts(await getCollection("posts"));
const recentPosts = posts.slice(0, 3);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="sticker">SOFTWARE ENGINEERING · YEAR 2</p>
      <h1>嗨，我是 Whyz。<br /><span>正在认真地成为自己。</span></h1>
      <p class="hero-lead">
        这里收集我在代码、书页、项目与生活中留下的脚印。
        不急着证明什么，只想把每一次理解都认真写下来。
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/posts">翻翻我的记录</a>
        <a class="button text-button" href="/about">认识一下我 <span>→</span></a>
      </div>
    </div>
    <div class="desk-note paper" aria-label="当前学习便签">
      <div class="tape" aria-hidden="true"></div>
      <p class="note-label">NOW LEARNING</p>
      <h2>此刻正在学习</h2>
      <ul>
        <li><span>01</span> 前端开发与 Astro</li>
        <li><span>02</span> 软件工程基础</li>
        <li><span>03</span> 用 Git 记录成长</li>
      </ul>
      <p class="scribble">一步一步，也很好。</p>
    </div>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">MY NOTEBOOKS</p>
        <h2>四本持续更新的手帐</h2>
      </div>
      <p>学习不只发生在课堂。每一类记录，都是理解世界的一种方式。</p>
    </div>
    <div class="category-grid">
      {Object.entries(CATEGORIES).map(([key, category], index) => (
        <a class={`category-card paper category-${index + 1}`} href={`/categories/${key}`}>
          <span class="category-icon" aria-hidden="true">{category.icon}</span>
          <span class="category-number">0{index + 1}</span>
          <h3>{category.label}</h3>
          <p>{category.description}</p>
          <span class="category-link">{category.english} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell section recent-section">
    <div class="section-heading compact">
      <div>
        <p class="eyebrow">RECENT STORIES</p>
        <h2>最近写下的</h2>
      </div>
      <a class="text-link" href="/posts">查看全部文章 →</a>
    </div>
    <div class="post-list">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="quote-section shell">
    <blockquote>
      <span aria-hidden="true">“</span>
      <p>比起漂亮的起点，我更想拥有长久的更新。</p>
      <footer>— 写给正在学习的自己</footer>
    </blockquote>
  </section>
</BaseLayout>
