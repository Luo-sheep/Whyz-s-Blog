---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面走丢了" description="没有找到你要访问的页面。">
  <section class="not-found shell">
    <div class="paper lost-note">
      <div class="tape" aria-hidden="true"></div>
      <p class="error-code">404</p>
      <h1>这一页好像夹进了别的手帐</h1>
      <p>别担心，我们可以回到熟悉的地方继续翻阅。</p>
      <a class="button primary" href="/">回到首页</a>
    </div>
  </section>
</BaseLayout>
