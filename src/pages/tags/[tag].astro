---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { visiblePosts } from "../../utils/posts";

export const getStaticPaths = (async () => {
  const posts = visiblePosts(await getCollection("posts"));
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
const posts = visiblePosts(await getCollection("posts")).filter((post) =>
  post.data.tags.includes(tag),
);
---

<BaseLayout title={`#${tag}`} description={`带有 ${tag} 标签的文章。`}>
  <section class="shell page-hero">
    <p class="eyebrow">TAG</p>
    <h1>#{tag}</h1>
    <p>共找到 {posts.length} 篇记录。</p>
  </section>
  <section class="shell section page-content">
    <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
  </section>
</BaseLayout>
