---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { CATEGORIES } from "../data/site";
import { formatDate, readingTime } from "../utils/posts";

interface Props {
  post: CollectionEntry<"posts">;
  headings: { depth: number; slug: string; text: string }[];
  previous?: CollectionEntry<"posts">;
  next?: CollectionEntry<"posts">;
}

const { post, headings, previous, next } = Astro.props;
const category = CATEGORIES[post.data.category];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover}>
  <article class="post shell">
    <header class="post-header paper">
      <div class="tape" aria-hidden="true"></div>
      <a class="eyebrow" href={`/categories/${post.data.category}`}>{category.label}</a>
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <div class="post-meta">
        <time datetime={post.data.publishDate.toISOString()}>
          {formatDate(post.data.publishDate)}
        </time>
        <span>{readingTime(post.body)} 分钟阅读</span>
        {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
      </div>
      <div class="tag-list">
        {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
      </div>
    </header>

    <div class="post-grid">
      {toc.length > 0 && (
        <aside class="toc paper" aria-label="文章目录">
          <p class="toc-title">这篇文章</p>
          <ol>
            {toc.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}
      <div class="prose paper">
        <slot />
      </div>
    </div>

    <nav class="post-pagination" aria-label="相邻文章">
      {previous ? (
        <a class="paper" href={`/posts/${previous.id}`}>
          <span>上一篇</span>
          <strong>{previous.data.title}</strong>
        </a>
      ) : <span />}
      {next && (
        <a class="paper align-right" href={`/posts/${next.id}`}>
          <span>下一篇</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
